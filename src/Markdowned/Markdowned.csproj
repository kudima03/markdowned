<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
    <IsAotCompatible>true</IsAotCompatible>
    <IsPackable>false</IsPackable>
    <RootNamespace>Markdowned</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.4.0" />
    <PackageReference Include="Pure.Primitives" Version="3.6.5" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Browser\browser.json" />
    <EmbeddedResource
      Include="Assets\**\*"
      Exclude="Assets\**\*.md;Assets\**\*.txt;Assets\**\*.LICENSE"
      LogicalName="assets/%(RecursiveDir)%(Filename)%(Extension)"
    />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Markdowned.Abstractions\Markdowned.Abstractions.csproj" />
  </ItemGroup>
</Project>
